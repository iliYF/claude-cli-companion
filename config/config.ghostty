# ============================================
# Claude Companion Ghostty Config - Built for efficient development with Claude
# Author: iliY
# Reload config: Cmd + Shift + ,
# ============================================

# ─────────────────────────────────────────────────────────────
# Theme and Colors
# ─────────────────────────────────────────────────────────────
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
# Opacity for unfocused splits
unfocused-split-opacity = 0.88

# ─────────────────────────────────────────────────────────────
# Typography
# ─────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 14
#font-thicken = true
adjust-cell-height = 2

# ─────────────────────────────────────────────────────────────
# Window and Appearance
# ─────────────────────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 12
window-save-state = always
window-theme = auto
# --- Frosted glass effect ---
background-opacity = 0.9
background-blur-radius = 20
macos-titlebar-style = transparent

# ─────────────────────────────────────────────────────────────
# Cursor
# ─────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8

# ─────────────────────────────────────────────────────────────
# Mouse
# ─────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = clipboard
link-url = true
confirm-close-surface = true
mouse-shift-capture = true

# ─────────────────────────────────────────────────────────────
# Quick Terminal
# ─────────────────────────────────────────────────────────────
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# ─────────────────────────────────────────────────────────────
# Shell Integration
# ─────────────────────────────────────────────────────────────
shell-integration = detect

# ─────────────────────────────────────────────────────────────
# Claude Code Optimizations
# ─────────────────────────────────────────────────────────────
initial-window = true
quit-after-last-window-closed = true
notify-on-command-finish = always

# ─────────────────────────────────────────────────────────────
# Performance
# ─────────────────────────────────────────────────────────────
scrollback-limit = 25000000

# ─────────────────────────────────────────────────────────────
# Shortcuts
# ─────────────────────────────────────────────────────────────
# --- Split panes ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

# --- Split resize ---
keybind = cmd+ctrl+left=resize_split:left,50
keybind = cmd+ctrl+right=resize_split:right,50
keybind = cmd+ctrl+up=resize_split:up,50
keybind = cmd+ctrl+down=resize_split:down,50

# --- Split management ---
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+f=toggle_split_zoom
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab

keybind = cmd+w=close_surface

# --- Tabs ---
keybind = cmd+t=new_tab
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5

# --- Font size ---
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# --- Global hotkey: quick terminal ---
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# --- Reload config ---
keybind = cmd+shift+comma=reload_config
